  "cases": [
    {
      "name": "a new platform is named, numbered and kept inside",
      "actions": [
        {
          "type": "CREATE_OBJECT",
          "objectType": "platform",
          "x": 1500,
          "y": 500,
          "w": 300
        },
        {
          "type": "CREATE_OBJECT",
          "objectType": "coin",
          "x": 600,
          "y": 560,
          "points": 25
        }
      ],
      "expect": {
        "count": 12,
        "created": [
          "platform-1",
          "coin-3"
        ],
        "objects": [
          {
            "id": "platform-1",
            "name": "Platform 6",
            "x": 1300,
            "y": 500,
            "w": 300,
            "h": 24
          },
          {
            "id": "coin-3",
            "name": "Coin 3",
            "x": 600,
            "y": 560,
            "w": 24,
            "h": 24,
            "behaviours": {
              "collectible": {
                "points": 25
              }
            }
          }
        ],
        "notes": [
          "+ Platform 6 at (1300, 500)",
          "+ Coin 3 at (600, 560)"
        ]
      },
      "notes": "The starter has five platforms (ids ground-* and ledge-*) and the coins coin-1 and coin-2, so the new ids are platform-1 and coin-3. 1500 + 300 > 1600, so x becomes 1300."
    },
    {
      "name": "creating a player moves the one there is",
      "actions": [
        {
          "type": "CREATE_OBJECT",
          "objectType": "player",
          "x": 400,
          "y": 672,
          "jump": 700
        }
      ],
      "expect": {
        "count": 10,
        "created": [],
        "objects": [
          {
            "id": "player",
            "name": "Player",
            "x": 400,
            "y": 672,
            "w": 32,
            "h": 48,
            "behaviours": {
              "controller": {
                "speed": 260,
                "jump": 700
              }
            }
          }
        ],
        "notes": [
          "~ Moved Player to (400, 672)"
        ]
      },
      "notes": "One player per scene."
    },
    {
      "name": "moving an enemy moves its patrol; a missing id is skipped",
      "actions": [
        {
          "type": "UPDATE_OBJECT",
          "id": "enemy-1",
          "x": 1100
        },
        {
          "type": "UPDATE_OBJECT",
          "id": "nope",
          "x": 1
        }
      ],
      "expect": {
        "count": 10,
        "created": [],
        "objects": [
          {
            "id": "enemy-1",
            "name": "Enemy",
            "x": 1100,
            "y": 784,
            "w": 40,
            "h": 36,
            "behaviours": {
              "patrol": {
                "from": 1000,
                "to": 1400,
                "speed": 90
              }
            }
          }
        ],
        "notes": [
          "~ Changed Enemy",
          "· Skipped: there is no nope"
        ]
      },
      "notes": "The enemy moves 100 to the right; its patrol 900..1300 becomes 1000..1400."
    },
    {
      "name": "delete, a behaviour, the scene and the score",
      "actions": [
        {
          "type": "DELETE_OBJECT",
          "id": "coin-2"
        },
        {
          "type": "ADD_COMPONENT",
          "id": "enemy-1",
          "component": "patrol",
          "speed": 150
        },
        {
          "type": "UPDATE_SCENE",
          "theme": "night",
          "sceneName": "Night run"
        },
        {
          "type": "UPDATE_UI",
          "score": false
        }
      ],
      "expect": {
        "count": 9,
        "created": [],
        "objects": [
          {
            "id": "enemy-1",
            "name": "Enemy",
            "x": 1000,
            "y": 784,
            "w": 40,
            "h": 36,
            "behaviours": {
              "patrol": {
                "from": 900,
                "to": 1300,
                "speed": 150
              }
            }
          }
        ],
        "missing": [
          "coin-2"
        ],
        "theme": "night",
        "name": "Night run",
        "score": false,
        "notes": [
          "− Removed Coin",
          "~ Set Enemy's patrol",
          "~ Scene renamed to Night run · night theme",
          "~ Score hidden"
        ]
      },
      "notes": "Four kinds of action in one batch."
    },
    {
      "name": "a given id is kept when it is free",
      "actions": [
        {
          "type": "CREATE_OBJECT",
          "objectType": "coin",
          "x": 100,
          "y": 100,
          "id": "sky-coin"
        },
        {
          "type": "CREATE_OBJECT",
          "objectType": "coin",
          "x": 140,
          "y": 100,
          "id": "coin-1"
        }
      ],
      "expect": {
        "count": 12,
        "created": [
          "sky-coin",
          "coin-3"
        ],
        "objects": [
          {
            "id": "sky-coin",
            "name": "Coin 3",
            "x": 100,
            "y": 100
          },
          {
            "id": "coin-3",
            "name": "Coin 4",
            "x": 140,
            "y": 100
          }
        ],
        "notes": [
          "+ Coin 3 at (100, 100)",
          "+ Coin 4 at (140, 100)"
        ]
      },
      "notes": "coin-1 is taken, so the second coin gets the lowest free coin-n. Names count the coins there are."
    },
    {
